# Copy to .env on the Docker host. Never commit .env.

# --- PostgreSQL (required) ---
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=erp_system
POSTGRES_PORT=5432
# Local uvicorn on the host: localhost
# Inside docker-compose.prod.yml this is overridden to "postgres"
POSTGRES_HOST=localhost

# --- API ---
ENVIRONMENT=production
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
# Comma-separated browser origins. Leave empty when nginx serves UI and API on the same origin.
CORS_ORIGINS=

# --- Optional AI assistant ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_CHROMA_PATH=/data/chroma
ATTACHMENTS_PATH=/data/attachments

# --- TIPTOP CSV import (Admin > CSV Import) ---
# Optional. Default: backend/data/imports locally; Docker/OCI compose sets /data/imports.
# Upload the four CSVs (or a zip) from the Admin page, then upsert. Do not hardcode a laptop path.
# GTT_DATA_DIR=/data/imports

# --- Local compose only (docker-compose.yml / pgAdmin) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
PGADMIN_PORT=5050
