[Unit]
Description=ERP API (FastAPI / uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/home/opc/erp-project/backend
Environment="PATH=/home/opc/erp-project/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/bin/bash -lc "source /home/opc/erp-project/.venv/bin/activate && uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips=*"
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
